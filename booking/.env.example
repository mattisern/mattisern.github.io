# Public URL of the site (no trailing slash). http://localhost:3000 when developing.
SITE_URL=http://localhost:3000

# Stripe — use sk_test_... keys until you're ready to go live.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=

# Google OAuth client (type "Desktop app") — see SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Printed by `npm run google-auth`.
GOOGLE_REFRESH_TOKEN=
# Calendar the bookings are written to. "primary" = your main calendar.
GOOGLE_CALENDAR_ID=primary

# Emails you about each new booking. From resend.com (see SETUP.md).
RESEND_API_KEY=
